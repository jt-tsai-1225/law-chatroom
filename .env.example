# Embedding API 金鑰 (請替換為您的實際 API Key)
EMBEDDING_API_KEY=your_api_key_here

# LLM Chat API 金鑰 (請替換為您的實際 API Key)
LLM_API_KEY=your_api_key_here

# Qdrant 配置 (可選)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_API_KEY=

# Embedding 模型配置 (可選)
# EMBEDDING_ENDPOINT=https://ainexus.phison.com/api/external/v1/embeddings
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# LLM 模型配置 (可選)
# LLM_ENDPOINT=https://ainexus.phison.com/api/external/v1/chat/completions
# LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
