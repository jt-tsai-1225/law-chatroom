<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.2.0" />
    <!--
      SeaweedFS 的 S3 相容閘道用它存取。走 S3 API 而非 SeaweedFS 原生 API，
      是為了不必自己處理 fid 的配發與保存（見 Services/SeaweedObjectStorage.cs）。

      版本用浮動的 3.7.*：3.7 是長期穩定線，本專案只用到 PutObject／GetObject／
      DeleteObject 這些十年沒變過的 API。
      ⚠ 浮動版本代表每次還原可能拿到不同的建置，要可重現的建置請改成
      首次還原實際取得的版本號（obj/project.assets.json 查得到）。
    -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.*" />
    <PackageReference Include="Qdrant.Client" Version="1.9.0" />
    <!--
      聊天室紀錄用。選 Npgsql 直連而非 EF Core：只有兩張表、沒有複雜關聯，
      為此在 k8s 裡多養一個 migration job 不划算。結構以冪等的
      CREATE TABLE IF NOT EXISTS 在啟動時建立（見 Services/ConversationStore.cs）。
    -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="uploads\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      法規解析腳本，必須隨發佈輸出一起帶走，否則容器內找不到它。
      後端以子行程呼叫（見 Services/LegalDocumentParser.cs），
      路徑由 RAGSettings.ParserScriptPath 指定，預設 tools/parse_pdf.py。
    -->
    <Content Include="tools/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
